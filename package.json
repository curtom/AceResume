{
  "name": "aceresume",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.19.0 <23",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down",
    "dev:web": "corepack pnpm --dir apps/web dev",
    "dev:api": "corepack pnpm --dir apps/api dev",
    "dev:worker": "corepack pnpm --dir apps/worker dev",
    "lint": "corepack pnpm check:boundaries && corepack pnpm lint:eslint && corepack pnpm lint:style && corepack pnpm format:check",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:style": "stylelint \"**/*.{css,less}\" --allow-empty-input",
    "format:check": "prettier --check .",
    "typecheck": "corepack pnpm --filter @aceresume/config --filter @aceresume/contracts run build && corepack pnpm --recursive --if-present run typecheck",
    "test": "corepack pnpm --recursive --if-present run test",
    "build": "corepack pnpm --recursive --if-present run build",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "e2e": "corepack pnpm --filter @aceresume/web e2e",
    "start:frontend": "node scripts/start-frontend.mjs",
    "start:backend": "node scripts/start-backend.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.30.1",
    "eslint-plugin-vue": "^10.2.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.21.0",
    "stylelint-config-standard": "^38.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}