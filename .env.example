# Local development values only. Copy this file to .env; never use these values in production.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api/v1

POSTGRES_DB=aceresume
POSTGRES_USER=aceresume
POSTGRES_PASSWORD=aceresume_local_password
DATABASE_URL=postgresql://aceresume:aceresume_local_password@127.0.0.1:5432/aceresume
REDIS_URL=redis://127.0.0.1:6379

STORAGE_ENDPOINT=127.0.0.1
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=aceresume_local
STORAGE_SECRET_KEY=aceresume_local_storage_secret
STORAGE_BUCKET=aceresume

MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=noreply@aceresume.test

AUTH_JWT_SECRET=local-development-only-secret-must-have-32
# Local development bypass only. Production should omit this or set it to true.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
WORKER_CONCURRENCY=1

# AI is intentionally not configured until Stage 6.
AI_CHAT_MODEL=qwen3.7-plus
AI_EMBEDDING_MODEL=qwen3.7-text-embedding
AI_EMBEDDING_DIMENSION=1024
