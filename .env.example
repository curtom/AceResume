# Local development values only. Copy this file to .env; never use these values in production.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api/v1

POSTGRES_DB=aceresume
POSTGRES_USER=aceresume
POSTGRES_PASSWORD=aceresume_local_password
DATABASE_URL=postgresql://aceresume:aceresume_local_password@127.0.0.1:5432/aceresume
REDIS_URL=redis://127.0.0.1:6379

STORAGE_ENDPOINT=127.0.0.1
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=aceresume_local
STORAGE_SECRET_KEY=aceresume_local_storage_secret
STORAGE_BUCKET=aceresume

MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=noreply@aceresume.test

AUTH_JWT_SECRET=local-development-only-secret-must-have-32
# Local development bypass only. Production should omit this or set it to true.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
WORKER_CONCURRENCY=1
DOCUMENT_MAX_FILE_BYTES=20971520
DOCUMENT_MAX_FILES=50
DOCUMENT_MAX_TOTAL_BYTES=209715200
DOCUMENT_MAX_PARSE_MS=30000
DOCUMENT_MAX_PAGES=100
DOCUMENT_MAX_TEXT_CHARS=1000000
DOCUMENT_MAX_DOCX_UNCOMPRESSED_BYTES=52428800

# AI defaults to the deterministic local provider. Set AI_PROVIDER=qwen and add the
# real key only in .env when validating the Alibaba Cloud Bailian integration.
AI_PROVIDER=mock
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen3.7-plus
AI_EMBEDDING_MODEL=qwen3.7-text-embedding
AI_EMBEDDING_DIMENSION=1024
AI_TIMEOUT_MS=30000
AI_RETRIEVAL_TOP_K=8
AI_CONTEXT_LIMIT=4
# DASHSCOPE_API_KEY=
